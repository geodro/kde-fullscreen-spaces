<ui version="4.0">
 <class>KWin::FullscreenSpacesConfigForm</class>
 <widget class="QWidget" name="KWin::FullscreenSpacesConfigForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>520</width>
    <height>320</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="groupBehaviour">
     <property name="title">
      <string>Behaviour</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutBehaviour">
      <item>
       <widget class="QCheckBox" name="kcfg_manageScreenSized">
        <property name="text">
         <string>Also give a Space to screen-sized windows</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="labelScreenSized">
        <property name="text">
         <string>Borderless "fullscreen windowed" games are reported by KWin as merely maximized. With this off, only real fullscreen windows get their own Space.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="groupExclusions">
     <property name="title">
      <string>Excluded applications</string>
     </property>
     <layout class="QVBoxLayout" name="verticalLayoutExclusions">
      <item>
       <widget class="QLabel" name="labelExclusions">
        <property name="text">
         <string>Comma-separated application ids (resource class or name), e.g. &quot;steam, org.kde.okular&quot;. These never get a Space and are never pushed off one. Screenshot tools, screen lockers and portal pickers are already excluded.</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLineEdit" name="kcfg_excludedClasses">
        <property name="placeholderText">
         <string>myapp, com.example.other</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="labelXprop">
        <property name="text">
         <string>Find an app's id with: qdbus6 org.kde.KWin /KWin org.kde.KWin.showDebugConsole</string>
        </property>
        <property name="wordWrap">
         <bool>true</bool>
        </property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="kcfg_debugLogging">
     <property name="text">
      <string>Log to the journal (journalctl --user -f | grep fs2desktop)</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="labelReload">
     <property name="text">
      <string>Changes apply after the script is reloaded: untick and re-tick it in the KWin Scripts list, or log out and back in.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
    </widget>
   </item>
   <item>
    <spacer name="verticalSpacer">
     <property name="orientation">
